{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "HeartRate.Api",
    "Audience": "HeartRate.Client",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "DatabaseName": "heart_rate"
  }
}
