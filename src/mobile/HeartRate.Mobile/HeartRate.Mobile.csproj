<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HeartRate.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiVersion>11.0.0</MauiVersion>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>HeartRate</ApplicationTitle>
    <ApplicationId>pl.example.heartrate</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#0F172A" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0F172A" BaseSize="128,128" />
    <MauiImage Include="Resources/Images/*" Exclude="Resources/Images/.gitkeep" />
    <MauiAsset
      Include="Resources/Raw/**"
      Exclude="Resources/Raw/.gitkeep"
      LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
